# APP
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=false
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000

# DATABASE
DATABASE_URL=sqlite:///data/lecture_platform.db
POSTGRES_USER=lecturebridge
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_DB=lecturebridge

# AUTH
SECRET_KEY=replace-with-a-strong-random-secret
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=10/minute
ALLOW_PUBLIC_ROLE_REGISTRATION=false
NEXT_PUBLIC_ALLOW_ROLE_REGISTRATION=false
ADMIN_EMAILS=

# AI PROVIDER
GEMINI_API_KEY=replace-with-your-gemini-api-key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-2.5-flash

# LECTURE INTELLIGENCE
WHISPER_MODEL_SIZE=base
SEMANTIC_CHUNK_MAX_TOKENS=1200
SEMANTIC_CHUNK_OVERLAP_SEGMENTS=2
SEMANTIC_EXTRACTION_MAX_ATTEMPTS=2
SEMANTIC_EXPLICIT_CONFIDENCE_THRESHOLD=0.55
SEMANTIC_INFERRED_CONFIDENCE_THRESHOLD=0.70
SEMANTIC_TITLE_SIMILARITY_THRESHOLD=0.60
QA_LINK_MIN_CONFIDENCE=0.70
QA_LINK_MAX_WINDOW_SECONDS=180
QA_LINK_MAX_ATTEMPTS=2
QA_LINK_CONTEXT_RADIUS_SEGMENTS=1
CONTEXT_RECOVERY_BOUNDARY_SECONDS=45
LECTURE_GROUNDING_MAX_ATTEMPTS=2
ASK_LECTURE_MAX_QUESTION_LENGTH=500
ASK_LECTURE_EVIDENCE_COUNT=8
ASK_LECTURE_RATE_LIMIT=20/minute
CONTEXT_RECOVERY_RATE_LIMIT=20/minute
MAX_REAL_PROVIDER_SAMPLES=3
MAX_ASK_QUERIES_PER_SAMPLE=2
MAX_CONTEXT_CALLS_PER_SAMPLE=1
SMOKE_PROVIDER_DELAY_SECONDS=5
SMOKE_RATE_LIMIT_MAX_ATTEMPTS=3
SMOKE_RATE_LIMIT_BACKOFF_SECONDS=5,15
SMOKE_RATE_LIMIT_JITTER_SECONDS=1
SMOKE_RATE_LIMIT_MAX_WAIT_SECONDS=30

# MEDIA
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=14400
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.avi,.mkv
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/x-msvideo,video/x-matroska
UPLOAD_RATE_LIMIT=20/hour

# OPTIONAL S3-COMPATIBLE STORAGE
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OPTIONAL REDIS / RQ
REDIS_URL=
